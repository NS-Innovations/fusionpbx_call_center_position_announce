#!/bin/sh
#
# PROVIDE: call_center_position
# REQUIRE: DAEMON
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable call_center_position:
# call_center_position_enable:           Set it to "YES" to enable call_center_position.
#                          Default is "NO".
#

. /etc/rc.subr
name="call_center_position"

rcvar=${name}_enable
load_rc_config $name

# Set defaults
: ${call_center_position_enable="NO"}
: ${call_center_position_pidfile="/var/run/call_center_position.pid"}

# Prepare the variables
start_cmd=${name}_start
stop_cmd=${name}_stop
status_cmd=${name}_status
pidfile=${call_center_position_pidfile}

# Path to the PHP script
script="/usr/local/www/fusionpbx/app/call_center_position/resources/service/call_center_position.php"

# Command to run the script
command="/usr/local/bin/php"

call_center_position_start() {
    echo "Starting $name..."
    if [ -f "$pidfile" ] && kill -0 "$(cat $pidfile)" 2>/dev/null; then
        echo "$name is already running."
    else
        # Fully detach from parent shell to prevent 'service' from blocking
        nohup $command $script </dev/null >/dev/null 2>&1 &
        echo $! > "$pidfile"
        echo "$name started."
    fi
}

call_center_position_stop() {
    echo "Stopping $name..."
    if [ -f "$pidfile" ] && kill -0 "$(cat $pidfile)" 2>/dev/null; then
        kill "$(cat $pidfile)"
        rm -f "$pidfile"
        echo "$name stopped."
    else
        echo "$name is not running."
    fi
}

call_center_position_status() {
    if [ -f "$pidfile" ] && kill -0 "$(cat $pidfile)" 2>/dev/null; then
        echo "$name is running with PID $(cat $pidfile)."
    else
        echo "$name is not running."
    fi
}

run_rc_command "$1"
