#!/bin/sh
#
# Call Center Position for FusionPBX - rc.d script
# Copyright (c) 2026 Norman King, MIT License
#
# PROVIDE: call_center_position
# REQUIRE: LOGIN postgresql freeswitch
# KEYWORD: shutdown
#
# Add to /etc/rc.conf to start at boot:
#   call_center_position_enable="YES"
# Optional:
#   call_center_position_user="www"   the user the service runs as

. /etc/rc.subr

name="call_center_position"
rcvar="${name}_enable"
load_rc_config $name

: ${call_center_position_enable:="NO"}
: ${call_center_position_user:="www"}

pidfile="/var/run/${name}.pid"
procname="/usr/local/bin/php"
script="/usr/local/www/fusionpbx/app/call_center_position/resources/service/call_center_position.php"

# daemon(8) keeps the service running and restarts it if it exits
command="/usr/sbin/daemon"
command_args="-f -r -P ${pidfile} -u ${call_center_position_user} ${procname} ${script}"

run_rc_command "$1"
